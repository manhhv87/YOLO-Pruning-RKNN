# =====================================================================
# Detector-free cabbage crop-row guidance project.
# Tracked = the python pipeline (*.py), run_all.sh, requirements.txt,
# README, paper sources (paper/**/*.tex, paper/refs.bib), the four used
# paper figures (paper/figures/*.png, paper/figures/IMG_*.jpg) and the
# compiled paper/main.pdf. Everything large, binary, generated or local
# stays out, per the rules below.
# =====================================================================

# ---- field dataset: local only ----
# The CabbageNav field dataset (frames + videos + manifest) is large and is
# released on publication (see the paper's Data and Code Availability), so it
# is not committed.
datasets/

# ---- generated evaluation / calibration / annotation outputs ----
results/
results_*.csv
calib_*.csv
gtlines_*.json

# ---- stray model binaries (legacy detector era; never commit) ----
weights/
runs/
*.pt
*.pth
*.onnx
*.engine
*.rknn
*.torchscript

# ---- bulky local EndNote reference-PDF library (citations live in refs.bib) ----
paper/ref/

# ---- LaTeX build artifacts (keep .tex, .bib, figures, main.pdf) ----
paper/*.aux
paper/*.bcf
paper/*.bbl
paper/*.bbl-SAVE-ERROR
paper/*.blg
paper/*.log
paper/*.out
paper/*.run.xml
paper/*.toc
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz
paper/sections/*.aux

# ---- python ----
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/

# ---- large local docs / field media (NOT part of the codebase) ----
*.MOV
*.mov
*.mp4
*.avi
/main.pdf
/*.docx

# ---- OS ----
.DS_Store
Thumbs.db
